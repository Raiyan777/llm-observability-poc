# ── Org-level: Langfuse server ──
LANGFUSE_HOST=http://YOUR_SERVER_IP:3000
LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxx

# ── Org-level: Internal LLM endpoint ──
LLM_BASE_URL=https://internal-llm.company.com/v1

# ── Per-deployment context ──
TEAM_NAME=platform-team
APPLICATION_NAME=demo-app
ENVIRONMENT=dev

# ── Per-developer (or pass at runtime via AI constructor) ──
