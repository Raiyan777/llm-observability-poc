# ══════════════════════════════════════════════════════════════
# company-ai SDK — Environment Variables (ALL OPTIONAL)
#
# The Langfuse connection and LLM base URL are baked into the
# package. You only need this file if you want to OVERRIDE
# defaults or set team/app context via env vars.
# ══════════════════════════════════════════════════════════════

# ── Override Langfuse connection (defaults are baked in) ──
# LANGFUSE_HOST=http://13.206.98.123:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxx

# ── Override LLM endpoint (default is baked in) ──
# LLM_BASE_URL=https://api.siemens.com/llm/v1

# ── Team / app context (optional, for dashboard filtering) ──
TEAM_NAME=your-team
APPLICATION_NAME=your-app
ENVIRONMENT=dev

# ── Per-developer (or pass at runtime via AI constructor) ──
# LLM_API_KEY=your-personal-key
# LLM_MODEL_NAME=your-model
