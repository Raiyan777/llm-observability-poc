# ============================================================
# Langfuse Server — Environment Variables
# Copy this to .env in the same directory as docker-compose.yml
# Generate secrets with:  openssl rand -hex 32
# ============================================================

# ── Postgres ──
POSTGRES_PASSWORD=changeme_postgres_password

# ── ClickHouse ──
CLICKHOUSE_PASSWORD=changeme_clickhouse_password

# ── Redis ──
REDIS_AUTH=changeme_redis_password

# ── MinIO (S3-compatible storage) ──
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=changeme_minio_password

# ── Langfuse App ──
NEXTAUTH_URL=http://YOUR_EC2_IP:3000
NEXTAUTH_SECRET=changeme_nextauth_secret
ENCRYPTION_KEY=changeme_64_hex_chars
SALT=changeme_salt

# ── Initial Project (auto-created on first boot) ──
LANGFUSE_INIT_ORG_NAME=your-company
LANGFUSE_INIT_PROJECT_NAME=llm-observability
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-generate-your-own
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-generate-your-own
LANGFUSE_INIT_USER_EMAIL=admin@company.com
LANGFUSE_INIT_USER_PASSWORD=changeme_admin_password
